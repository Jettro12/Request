{
  "name": "request-app",
  "private": true,
  "workspaces": [
    "frontend",
    "services/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build --concurrency=3",
    "lint": "turbo run lint",
