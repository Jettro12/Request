{
  "name": "auth-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prisma:generate": "prisma generate",
    "dev": "npm run prisma:generate && ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "npm run prisma:generate && tsc -p .",
    "lint": "eslint src --max-warnings=0",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "start": "npx prisma db push && node dist/index.js"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@types/amqplib": "^0.10.8",
    "amqplib": "^0.10.9",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "prisma": "^5.20.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20.5.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0"
  }
}
