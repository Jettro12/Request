{
  "name": "users-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prisma:generate": "prisma generate",
    "dev": "npm run prisma:generate && ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "npm run prisma:generate && tsc -p .",
    "start": "npm run dev",
    "lint": "eslint src --max-warnings=0",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "amqplib": "^0.10.9",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "prisma": "^5.20.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.8.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.27",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
