generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Rating {
  id        String   @id @default(cuid())
  fromUser  String
  toUser    String
  score     Int
  comment   String?
  createdAt DateTime @default(now())

  @@map("ratings")
}