// prisma/schema.prisma - posts-service
// User data is managed by users-service (shared authdb).
// This service only manages Post records and authorId references.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Post {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  type        String
  careerSpace String
  skills      String[] @default([])
  authorId    String
  
  // AGREGAR ESTA RELACIÓN (pero será simulada)
  // author      User?    @relation(fields: [authorId], references: [id])
  // Comentada porque User no está definido en este schema
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([authorId])
  @@index([careerSpace])
  @@index([createdAt])
  @@map("posts")
}
