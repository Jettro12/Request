{
  "name": "profile-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prisma:generate": "prisma generate",
    "dev": "npm run prisma:generate && ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "npm run prisma:generate && tsc -p .",
    "start": "npm run dev",
    "lint": "eslint src --max-warnings=0",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "prisma": "^5.20.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.1.4"
  },
  "devDependencies": {
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0",
    "@types/express": "^4.17.17",
    "@types/node": "^20.5.1",
    "@types/cors": "^2.8.12"
  }
}
