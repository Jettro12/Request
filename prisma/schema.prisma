generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String         @id @default(cuid())
  email             String         @unique
  name              String
  password          String?
  avatar            String?
  career            String
  semester          Int
  bio               String?
  skills            String[]
  interests         String[]
  rating            Float          @default(0)
  reviewCount       Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  emailVerified     DateTime?
  accounts          Account[]
  receivedMessages  Message[]      @relation("ReceivedMessages")
  sentMessages      Message[]      @relation("SentMessages")
  sentNotifications Notification[] @relation("NotificationSender")
  notifications     Notification[] @relation("UserNotifications")
  posts             Post[]
  sentRequests      Request[]      @relation("SentRequests")
  receivedRequests  Request[]      @relation("ReceivedRequests")
  reviewsGiven      Review[]       @relation("ReviewsGiven")
  reviewsReceived   Review[]       @relation("ReviewsReceived")
  sessions          Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Post {
  id          String   @id @default(cuid())
  title       String
  content     String
  type        PostType
  authorId    String
  careerSpace String
  skills      String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("posts")
}

model Request {
  id                  String        @id @default(cuid())
  type                RequestType
  message             String
  status              RequestStatus @default(PENDING)
  fromUserId          String
  toUserId            String
  agreementProposedAt DateTime?
  agreementAcceptedBy String[]
  completedAt         DateTime?
  fromUserRating      Int?
  toUserRating        Int?
  fromUserReview      String?
  toUserReview        String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  messages            Message[]
  fromUser            User          @relation("SentRequests", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser              User          @relation("ReceivedRequests", fields: [toUserId], references: [id], onDelete: Cascade)

  @@map("requests")
}

model Message {
  id         String      @id @default(cuid())
  content    String
  requestId  String?
  senderId   String
  receiverId String
  read       Boolean     @default(false)
  type       MessageType @default(TEXT)
  createdAt  DateTime    @default(now())
  receiver   User        @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  request    Request?    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sender     User        @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Review {
  id          String   @id @default(cuid())
  rating      Int
  comment     String?
  fromUserId  String
  toUserId    String
  projectName String
  createdAt   DateTime @default(now())
  fromUser    User     @relation("ReviewsGiven", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser      User     @relation("ReviewsReceived", fields: [toUserId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  userId    String
  senderId  String?
  relatedId String?
  createdAt DateTime         @default(now())
  sender    User?            @relation("NotificationSender", fields: [senderId], references: [id])
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}

enum NotificationType {
  NEW_MESSAGE
  REQUEST_RECEIVED
  REQUEST_ACCEPTED
  REQUEST_REJECTED
  AGREEMENT_PROPOSAL
  AGREEMENT_ACCEPTED
  AGREEMENT_REJECTED
  RATING_RECEIVED
  PROJECT_COMPLETED
}

enum MessageType {
  TEXT
  AGREEMENT_PROPOSAL
  AGREEMENT_ACCEPTED
  AGREEMENT_REJECTED
  RATING_REQUEST
}

enum PostType {
  JOB
  PROJECT
  COLLABORATION
  ENTREPRENEURSHIP
  ANNOUNCEMENT
}

enum RequestType {
  COLLABORATION
  ADVICE
  JOB_OFFER
  MENTORSHIP
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}
