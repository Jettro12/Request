# 🌐 URL del Frontend (El DNS del Load Balancer)
# NextAuth necesita esto para saber dónde redireccionar tras el login
NEXTAUTH_URL=http://app-alb-1801547183.us-east-1.elb.amazonaws.com

# 🛡️ Seguridad
NEXTAUTH_SECRET=tu-clave-secreta-muy-larga

# 🚀 URL de la API (Punto clave)
# Debe llevar el prefijo /api para que Nginx sepa que no es una página
NEXT_PUBLIC_API_BASE_URL=http://app-alb-1801547183.us-east-1.elb.amazonaws.com/api

