# ==========================================
# Archivo: ./frontend/Dockerfile
# ==========================================

# 1. Etapa de Dependencias
FROM node:18-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
# Usamos npm install para ser flexibles con versiones
RUN npm install 

# 2. Etapa de Construcción (Builder)
FROM node:18-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
# Aquí se copia TODO (incluyendo tu carpeta 'src') para poder compilar
COPY . .

# Argumentos (Variables de entorno para el build)
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXTAUTH_SECRET
ARG DATABASE_URL

ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXTAUTH_SECRET=$NEXTAUTH_SECRET
ENV DATABASE_URL=$DATABASE_URL

# Si usas prisma en frontend descomenta:
# RUN npx prisma generate

# Aquí Next.js toma tu 'src', lo compila y lo guarda en '.next'
RUN npm run build

# 3. Etapa de Ejecución (Runner) - La imagen final ligera
FROM node:18-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# --- CORRECCIÓN ---
# Como no tienes carpeta 'public', ELIMINAMOS o COMENTAMOS esta línea.
# NO la cambies por 'src'. El runner no necesita 'src'.
# COPY --from=builder /app/public ./public
# ------------------

# Copiamos la aplicación ya compilada (que viene de tu src original)
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000
ENV PORT=3000

CMD ["node", "server.js"]